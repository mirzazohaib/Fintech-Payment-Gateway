{
  "info": {
    "name": "FinTech_Gateway",
    "description": "PSD2 Payment Gateway APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Experience Layer",
      "item": [
        {
          "name": "[EXP-001] Initiate Payment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 50.00,\n    \"currency\": \"EUR\",\n    \"description\": \"Groceries\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{mule_host}}:8084/api/pay",
              "protocol": "http",
              "host": ["{{mule_host}}"],
              "port": "8084",
              "path": ["api", "pay"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Process Layer",
      "item": [
        {
          "name": "[PROC-001] Orchestrate Payment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paymentId\": \"PAY-ORCH-TEST-001\",\n    \"amount\": 999.00,\n    \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{mule_host}}:8083/payment",
              "protocol": "http",
              "host": ["{{mule_host}}"],
              "port": "8083",
              "path": ["payment"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. System Layer",
      "item": [
        {
          "name": "[SYS-001] Send Payment to MQ",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paymentId\": \"PAY-1001\",\n    \"amount\": 150.00,\n    \"currency\": \"EUR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{mule_host}}:{{mq_port}}/mq/messages",
              "protocol": "http",
              "host": ["{{mule_host}}"],
              "port": "{{mq_port}}",
              "path": ["mq", "messages"]
            }
          },
          "response": []
        },
        {
          "name": "[SYS-002] Log Audit Event",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event\": \"PAYMENT_INITIATED\",\n    \"status\": \"SUCCESS\",\n    \"details\": \"Sent to MQ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://{{mule_host}}:{{audit_port}}/audit/events",
              "protocol": "http",
              "host": ["{{mule_host}}"],
              "port": "{{audit_port}}",
              "path": ["audit", "events"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Security (Keycloak)",
      "item": [
        {
          "name": "Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"access_token\", jsonData.access_token);",
                  "console.log(\"Token saved to environment\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "john.doe",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/psd2/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "psd2", "protocol", "openid-connect", "token"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
