<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" 
	xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

	<munit:config name="proc-payment-api-test-suite.xml" />

	<munit:test name="process-payment-flow-success-test" description="Test happy path payment processing">
		<munit:behavior>
            <munit-tools:mock-when doc:name="Mock Metrics Subflow" processor="flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Record Payment Metric" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[payload]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Auth Validation" processor="flow-ref">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Enforce Auth" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[payload]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Audit Init" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Log: Initiated" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[{'status': 'logged'}]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock MQ Call" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Call MQ API" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[{'status': 'queued'}]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when doc:name="Mock Audit Complete" processor="http:request">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Log: Completed" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[{'status': 'logged'}]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<munit:set-event doc:name="Set Payment Payload">
				<munit:payload value='{
					"paymentId": "12345",
					"amount": 100.00,
					"currency": "EUR"
				}' mediaType="application/json" />
				<munit:attributes value="#[{headers: {'Authorization': 'Bearer test-token'}}]" />
			</munit:set-event>
			
			<flow-ref doc:name="Flow-ref to process-payment-flow" name="process-payment-flow"/>
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that doc:name="Assert Status Accepted" expression="#[payload.status]" is="#[MunitTools::equalTo('Payment Accepted')]" />
			<munit-tools:verify-call doc:name="Verify MQ Called" processor="http:request" times="1">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Call MQ API" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

</mule>